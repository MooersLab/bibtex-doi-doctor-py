% Sample BibTeX file for the bibtex-doi-doctor tutorial.
% Each entry shows one kind of problem that the tool repairs or reports.

@string{actad = "Acta Crystallographica Section D: Biological Crystallography"}

% 1. DOI with a "doi:" prefix. litdb rejects it; the tool rewrites it.
@article{Emsley2010FeaturesDevelopmentCoot,
  author  = {Emsley, Paul and Lohkamp, Bernhard and Scott, William G. and Cowtan, Kevin},
  title   = {Features and development of {Coot}},
  journal = actad,
  year    = {2010},
  volume  = {66},
  number  = {4},
  pages   = {486--501},
  doi     = {doi:10.1107/S0907444910007493}
}

% 2. DOI given as a full https URL. litdb accepts it, but the bare form is cleaner.
@article{Kabsch2010Xds,
  author  = {Kabsch, Wolfgang},
  title   = {{XDS}},
  journal = actad,
  year    = {2010},
  volume  = {66},
  number  = {2},
  pages   = {125--132},
  doi     = {https://doi.org/10.1107/S0907444909047337}
}

% 3. DOI that lost its leading "1".
@article{Berman2000ProteinDataBank,
  author  = {Berman, Helen M. and Westbrook, John and Feng, Zukang and Gilliland, Gary
             and Bhat, T. N. and Weissig, Helge and Shindyalov, Ilya N. and Bourne, Philip E.},
  title   = {The {Protein} {Data} {Bank}},
  journal = {Nucleic Acids Research},
  year    = {2000},
  volume  = {28},
  number  = {1},
  pages   = {235--242},
  doi     = {0.1093/nar/28.1.235}
}

% 4. No doi field, but the DOI hides in a publisher URL with a download tail.
@article{Winn2011OverviewCcp4SuiteCurrentDevelopments,
  author  = {Winn, Martyn D. and Ballard, Charles C. and Cowtan, Kevin D. and Dodson, Eleanor J.
             and Emsley, Paul and Evans, Phil R. and Keegan, Ronan M. and Krissinel, Eugene B.
             and Leslie, Andrew G. W. and McCoy, Airlie and others},
  title   = {Overview of the {CCP4} suite and current developments},
  journal = actad,
  year    = {2011},
  volume  = {67},
  number  = {4},
  pages   = {235--242},
  url     = {https://onlinelibrary.wiley.com/doi/pdf/10.1107/S0907444910045749?download=true}
}

% 5. No DOI anywhere. The tool asks Crossref.
@article{Adams2010PhenixComprehensivePythonBasedSystem,
  author  = {Adams, Paul D. and Afonine, Pavel V. and Bunk{\'o}czi, G{\'a}bor and Chen, Vincent B.
             and Davis, Ian W. and Echols, Nathaniel and Headd, Jeffrey J. and Hung, Li-Wei
             and Kapral, Gary J. and Grosse-Kunstleve, Ralf W. and others},
  title   = {{PHENIX}: a comprehensive {Python}-based system for macromolecular structure solution},
  journal = actad,
  year    = {2010},
  volume  = {66},
  number  = {2},
  pages   = {213--221}
}

% 6. The doi field holds an ISSN instead of a DOI. The tool asks Crossref
%    and replaces the field when it finds a verified match.
@article{Jumper2021HighlyAccurateProteinStructurePrediction,
  author  = {Jumper, John and Evans, Richard and Pritzel, Alexander and Green, Tim
             and Figurnov, Michael and others},
  title   = {Highly accurate protein structure prediction with {AlphaFold}},
  journal = {Nature},
  year    = {2021},
  volume  = {596},
  number  = {7873},
  pages   = {583--589},
  doi     = {ISSN: 0028-0836}
}

% 7. A web page. Entry type misc is not looked up by default.
@misc{Litdb2026Repository,
  author       = {Kitchin, John},
  title        = {litdb: a literature database built on {OpenAlex}},
  howpublished = {\url{https://github.com/jkitchin/litdb}},
  year         = {2026}
}
